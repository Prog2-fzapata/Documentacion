# Configuración del compose que levanta catálogo y turnos juntos. Copiar a ".env" en esta carpeta y completar:
#   cp .env.example .env
# ".env" está en .gitignore y NUNCA se versiona. Compose lo lee solo: no hace falta cargarlo en el shell.
# Si falta una variable obligatoria, Compose se detiene y dice cuál. Lo que vale para los dos servicios se define
# una sola vez acá; los .env de cada servicio solo se usan para correrlos por separado (README de cada uno).

# --- Puertos del host (todo se publica solo en 127.0.0.1) ---
CATALOGO_PORT=8081
TURNOS_PORT=8082
CATALOGO_POSTGRES_PORT=5432
TURNOS_POSTGRES_PORT=5433

SPRING_PROFILES_ACTIVE=dev

# --- Bases de datos: cada servicio tiene la suya ---
CATALOGO_DB_NAME=catalogo_db
CATALOGO_DB_USER=catalogo_user
CATALOGO_DB_PASSWORD=cambiar
TURNOS_DB_NAME=turnos_db
TURNOS_DB_USER=turnos_user
TURNOS_DB_PASSWORD=cambiar

# --- Compartido: los dos servicios usan el mismo valor ---
# Clave HMAC del JWT en Base64 (mínimo 512 bits): generar con `openssl rand -base64 64`. Catálogo firma los tokens y
# turnos los valida con la misma clave.
JWT_SECRET=cambiar

# Cátedra: URL base de su API (sin "/" final) y JWT técnico (el id_token que devuelve su POST /api/authenticate).
# Los entrega la cátedra al registrar la cuenta técnica; el JWT dura un año.
CATEDRA_BASE_URL=cambiar
CATEDRA_JWT=cambiar

# Kafka de la cátedra, datos de la cuenta técnica ("integration"): como servidor va la IP de ZeroTier con el puerto de
# kafkaBootstrapServers (no el host interno que informa la API) y el grupo es kafkaConsumerGroupId.
CATEDRA_KAFKA_BOOTSTRAP_SERVERS=cambiar
CATEDRA_KAFKA_GROUP_ID=cambiar

# --- Solo catálogo ---
# Redis de la cátedra (solo lectura). Como host va la IP de ZeroTier, porque el que devuelve la cátedra es interno.
CATEDRA_REDIS_HOST=cambiar
CATEDRA_REDIS_PORT=6379
CATEDRA_REDIS_USERNAME=cambiar
CATEDRA_REDIS_PASSWORD=cambiar

# Topic de Kafka que catálogo consume (kafkaCatalogTopic).
CATEDRA_KAFKA_CATALOG_TOPIC=cambiar

# Nombres del contrato de la cátedra: ruta del snapshot y claves de Redis. Traen los valores del contrato v1; si la
# cátedra cambia alguno, se edita acá y se reinician los servicios, sin tocar el código.
CATEDRA_SNAPSHOT_PATH=/api/synchronization/snapshot
CATEDRA_REDIS_KEY_METADATA=catedra:sync:metadata
CATEDRA_REDIS_KEY_CHANGES_PREFIX=catedra:sync:changes:
CATEDRA_REDIS_KEY_CATEGORIES=catedra:sync:professional-categories
CATEDRA_REDIS_KEY_PROFESSIONALS=catedra:sync:professionals
CATEDRA_REDIS_KEY_WEEKLY_SCHEDULES=catedra:sync:weekly-schedules

# Costo del hash de contraseñas (Argon2id). Traen los mínimos de OWASP y el servicio no arranca si se baja alguno.
PASSWORD_ARGON2_MEMORY_KIB=19456
PASSWORD_ARGON2_ITERATIONS=2
PASSWORD_ARGON2_PARALLELISM=1

# --- Solo turnos ---
# Topics de Kafka de la cuenta técnica: kafkaAppointmentActionsTopic (eventos de la cátedra) y kafkaAppointmentPhoneTopic
# (al que se publica el teléfono), y el groupId de la cuenta (integration.groupId), que el mensaje del teléfono lleva
# como campo obligatorio.
CATEDRA_KAFKA_APPOINTMENT_ACTIONS_TOPIC=cambiar
CATEDRA_KAFKA_APPOINTMENT_PHONE_TOPIC=cambiar
CATEDRA_GROUP_ID=cambiar

# --- Parámetros de ajuste (opcionales) ---
# No se definen acá: el valor por defecto está en el application.properties de cada servicio. Para cambiar uno, agregarlo
# a este archivo (por ejemplo LOG_FORMAT=json o RESERVATION_HOLD_MAX_ATTEMPTS=3) y el entorno gana.
